{
  "name": "@clipper/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "android": "expo run:android",
    "check": "tsgo --noEmit",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "preandroid": "pnpm --dir ../packages/mobile-bridge run ubrn:android",
    "start": "expo start",
    "test": "node --experimental-strip-types --test tests/*.test.ts ../scripts/mobile-resume.test.mjs ../scripts/gym-rest-countdown.test.mjs"
  },
  "dependencies": {
    "@clipper/mobile-bridge": "workspace:*",
    "@clipper/shared": "workspace:*",
    "@tamagui/config": "2.7.7",
    "@tamagui/core": "2.7.7",
    "expo": "57.0.27",
    "expo-clipboard": "~57.0.2",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-modules-core": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "lib0": "0.2.119",
    "lucide-react-native": "1.52.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.15.5",
    "tamagui": "2.7.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@expo/metro": "56.1.0",
    "@react-native/typescript-config": "0.86.3",
    "@tamagui/babel-plugin": "2.7.7",
    "@types/react": "~19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "babel-preset-expo": "57.0.14",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "~7.0.2"
  },
  "packageManager": "pnpm@11.28.2",
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-secure-store"
        ]
      }
    },
    "install": {
      "exclude": [
        "typescript",
        "@types/react",
        "react-native-safe-area-context",
        "react-native-svg"
      ]
    }
  }
}
