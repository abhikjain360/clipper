{
  "expo": {
    "name": "Clipper",
    "slug": "clipper",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "../assets/icon/clipper.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.clipper.mobile",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "../assets/icon/android-foreground.png",
        "backgroundImage": "../assets/icon/android-background.png"
      }
    },
    "plugins": ["expo-secure-store", "expo-sharing", "./plugins/clipboard-lint.cjs"]
  }
}
