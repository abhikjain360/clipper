{
  "expo": {
    "name": "Clipper",
    "slug": "clipper",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "../assets/icon/clipper.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.clipper.mobile",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "../assets/icon/android-foreground.png",
        "backgroundImage": "../assets/icon/android-background.png"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      "./plugins/clipboard-lint.cjs",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/libron/Libron-Regular.ttf",
            "./assets/fonts/libron/Libron-Italic.ttf",
            "./assets/fonts/libron/Libron-Bold.ttf",
            "./assets/fonts/libron/Libron-BoldItalic.ttf",
            "./assets/fonts/fira-code/FiraCode-Regular.ttf",
            "./assets/fonts/fira-code/FiraCode-Medium.ttf",
            "./assets/fonts/fira-code/FiraCode-SemiBold.ttf",
            "./assets/fonts/fira-code/FiraCode-Bold.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Libron",
                "fontDefinitions": [
                  { "path": "./assets/fonts/libron/Libron-Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/libron/Libron-Regular.ttf", "weight": 500 },
                  { "path": "./assets/fonts/libron/Libron-Bold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/libron/Libron-Bold.ttf", "weight": 700 },
                  {
                    "path": "./assets/fonts/libron/Libron-Italic.ttf",
                    "weight": 400,
                    "style": "italic"
                  },
                  {
                    "path": "./assets/fonts/libron/Libron-Italic.ttf",
                    "weight": 500,
                    "style": "italic"
                  },
                  {
                    "path": "./assets/fonts/libron/Libron-BoldItalic.ttf",
                    "weight": 600,
                    "style": "italic"
                  },
                  {
                    "path": "./assets/fonts/libron/Libron-BoldItalic.ttf",
                    "weight": 700,
                    "style": "italic"
                  }
                ]
              },
              {
                "fontFamily": "Fira Code",
                "fontDefinitions": [
                  { "path": "./assets/fonts/fira-code/FiraCode-Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/fira-code/FiraCode-Medium.ttf", "weight": 500 },
                  { "path": "./assets/fonts/fira-code/FiraCode-SemiBold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/fira-code/FiraCode-Bold.ttf", "weight": 700 }
                ]
              }
            ]
          }
        }
      ]
    ]
  }
}
